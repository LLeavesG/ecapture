{
  "version": 1,
  "name": "ecapture-iovec-integration-fixture",
  "match": {
    "pid": 999999,
    "abi": "arm64"
  },
  "capture": {
    "strategies": [
      "application_data"
    ]
  },
  "tls": {
    "library": "/usr/lib/aarch64-linux-gnu/libssl.so.3",
    "hooks": {
      "ssl_read": {
        "disabled": true
      },
      "ssl_write": {
        "disabled": true
      },
      "ssl_set_fd": {
        "disabled": true
      },
      "ssl_set_rfd": {
        "disabled": true
      },
      "ssl_set_wfd": {
        "disabled": true
      }
    }
  },
  "data_hooks": [
    {
      "name": "fixture-writev",
      "library": "/tmp/ecapture-iovec-helper",
      "symbol": "ecapture_test_writev",
      "direction": "write",
      "capture_on": "entry",
      "buffer_arg": 2,
      "buffer_format": "iovec",
      "vector_count_arg": 3,
      "context_arg": 1,
      "max_bytes": 131072
    },
    {
      "name": "fixture-readv",
      "library": "/tmp/ecapture-iovec-helper",
      "symbol": "ecapture_test_readv",
      "direction": "read",
      "capture_on": "return",
      "buffer_arg": 2,
      "buffer_format": "iovec",
      "vector_count_arg": 3,
      "context_arg": 1,
      "max_bytes": 131072
    },
    {
      "name": "fixture-sendmsg",
      "library": "/tmp/ecapture-iovec-helper",
      "symbol": "ecapture_test_sendmsg",
      "direction": "write",
      "capture_on": "entry",
      "buffer_arg": 2,
      "buffer_format": "msghdr",
      "context_arg": 1,
      "max_bytes": 131072
    },
    {
      "name": "fixture-recvmsg",
      "library": "/tmp/ecapture-iovec-helper",
      "symbol": "ecapture_test_recvmsg",
      "direction": "read",
      "capture_on": "return",
      "buffer_arg": 2,
      "buffer_format": "msghdr",
      "context_arg": 1,
      "max_bytes": 131072
    },
    {
      "name": "fixture-higharg-quic-writev",
      "library": "/tmp/ecapture-iovec-helper",
      "symbol": "ecapture_test_higharg_iovec",
      "direction": "write",
      "capture_on": "return",
      "buffer_arg": 10,
      "buffer_format": "iovec",
      "vector_count_arg": 11,
      "length_source": "memory",
      "length_arg": 7,
      "length_size": 8,
      "context_arg": 1,
      "stream_arg": 9,
      "max_bytes": 131072
    }
  ],
  "metadata": {
    "purpose": "safe verifier and flattened iovec reconstruction integration fixture",
    "pid_placeholder": "replace 999999 with the running helper PID"
  }
}
